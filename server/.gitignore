# Git ignore rules for environment files, dependencies, logs, builds and uploads

# Dependencies
node_modules/

# Environment variables
.env

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Build output
dist/
build/

# Ignore uploads folder 
uploads/

# OS-specific files
.DS_Store
Thumbs.db

# IDE/editor settings
.vscode/
.idea/

#before hosting server code
server.txt